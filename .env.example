# Copia este archivo a .env y rellénalo. NO subas el .env a ningún repositorio.
# docker compose lo lee solo si lo pasas con `env_file:` o con `docker compose --env-file .env`.

# --- Sonarr / Radarr (obligatorio) -------------------------------------------------------------
# Dirección tal como la ve el contenedor de duberr (nombre del servicio en la red compartida) y clave de API
# (Ajustes → General → Seguridad en cada aplicación).
SONARR_URL=http://sonarr:8989
SONARR_KEY=
RADARR_URL=http://radarr:7878
RADARR_KEY=

# --- Seguridad (recomendado) -----------------------------------------------------------------------
# Contraseña de la web (HTTP Basic; el usuario puede ser cualquiera). Vacío = sin contraseña.
DUBERR_PASSWORD=
# Token del webhook de Sonarr/Radarr. Vacío = duberr genera uno la primera vez y lo enseña en Ajustes.
DUBERR_WEBHOOK_TOKEN=

# --- Avisos opcionales (ntfy) --------------------------------------------------------------------
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
